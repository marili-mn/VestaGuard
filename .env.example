# VESTA SECURITY CORE - ENVIRONMENT CONFIGURATION

# --- API KEYS ---
# Get your key from: https://www.virustotal.com/gui/user/apikey
VITE_VT_API_KEY=your_virustotal_api_key_here

# Get your key from: https://platform.openai.com/account/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# --- CONFIGURATION ---
# Base URL for the backend orchestration service (if separate)
VITE_API_BASE_URL=http://localhost:8000

# Feature Flags
VITE_ENABLE_MOCK_MODE=true
VITE_ENABLE_DEBUG_LOGS=false
